diff --git a/engine/src/mastertimer.cpp b/engine/src/mastertimer.cpp
index 1b7bcac..376c3af 100644
--- a/engine/src/mastertimer.cpp
+++ b/engine/src/mastertimer.cpp
@@ -152,6 +152,22 @@ void MasterTimer::timerTick()
     timerTickFunctions(universes);
     timerTickDMXSources(universes);
 
+    /* Wake the Universe threads directly from this thread, while the
+     * universe list is still claimed so no universe can be deleted under us.
+     * Universe::tick() only releases a semaphore. A queued signal here would
+     * run tick() in the thread that owns the Universe objects (the main/GUI
+     * thread), which makes DMX output wait for the GUI event loop.
+     *
+     * Not while a project is loading: Doc::loadXML() reconfigures universes
+     * from the main thread without synchronising with the Universe threads,
+     * and the universes used to stay idle during a load anyway, because the
+     * busy main thread could not deliver the queued ticks. */
+    if (doc->loadStatus() != Doc::Loading)
+    {
+        for (Universe *universe : std::as_const(universes))
+            universe->tick();
+    }
+
     doc->inputOutputMap()->releaseUniverses();
 
     m_beatRequested = false;
