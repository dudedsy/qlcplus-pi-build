+
+#include <QObject>
+
+class UniverseTick_Test final : public QObject
+{
+    Q_OBJECT
+
+private slots:
+    /* Universe output must keep its cadence while the main (GUI) thread is
+     * busy and not processing events. */
+    void outputCadenceWhileMainThreadBusy();
+
+    /* Universes can be removed and re-added from the main thread while the
+     * MasterTimer is ticking, without crashing. */
+    void addRemoveUniversesWhileTicking();
+
+    /* How many universe output passes run while the main thread is busy
+     * adding and deleting fixtures (which reconfigures Universe channel data
+     * with no lock shared with the Universe thread). */
+    void fixtureChurnWhileTicking();
+
+    /* Universe output passes while Doc::loadXML() runs on the main thread
+     * with the MasterTimer running (how App::loadWorkspace() loads). */
+    void outputDuringProjectLoad();
+};
